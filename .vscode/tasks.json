{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": ["-S", ".", "-B", "build", "-G", "MinGW Makefiles", "-DCMAKE_BUILD_TYPE=Debug"]
    },
    {
      "label": "build",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/cmake.exe --build build",
      "dependsOn": "configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}